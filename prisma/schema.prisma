// Kalvi — adaptive learning agent
// Prisma schema. Target: Postgres (Supabase). pgvector added later for curriculum RAG.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase pgbouncer, port 6543) — used for app queries.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — Prisma uses this for migrations/db push,
  // which can't run through the pooler.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum LearningStyle {
  VISUAL
  AUDITORY
  READING
  KINESTHETIC
  MIXED
}

enum Pace {
  SLOW
  MODERATE
  FAST
}

enum ExplanationLength {
  BRIEF
  MODERATE
  DETAILED
}

// ---------------------------------------------------------------------------
// Auth models (NextAuth Prisma adapter)
// These mirror the shapes NextAuth expects. Kept in the same schema so the
// adapter and our app models share one datasource.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  // NextAuth relations
  accounts Account[]
  authSessions Session[]

  // App relations
  profile          LearnerProfile?
  learningSessions LearningSession[]
  progress         ProgressRecord[]

  @@index([email])
}

model LearnerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  onboardingComplete Boolean @default(false)

  learningStyle LearningStyle     @default(MIXED)
  pace          Pace              @default(MODERATE)
  // Postgres text[] — e.g. ["dyslexia", "adhd", "esl"]
  disabilities  String[]          @default([])
  subjects      String[]          @default([])
  gradeLevel    String?
  nativeLanguage String           @default("English")
  preferredExplanationLength ExplanationLength @default(MODERATE)

  // Learned over time by the agent via the update_learner_profile tool.
  confusionKeywords String[] @default([])
  successPatterns   String[] @default([])

  totalSessions Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model LearningSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject String
  topic   String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  messageCount   Int   @default(0)
  confusionCount Int   @default(0)
  completionRate Float @default(0)

  // Full conversation history: { role, content, ... }[]
  messages Json @default("[]")

  @@index([userId])
  @@index([userId, subject])
}

model ProgressRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject String
  topic   String

  masteryLevel  Float     @default(0) // 0.0 .. 1.0
  lastReviewedAt DateTime @default(now())
  nextReviewAt  DateTime? // spaced-repetition scheduling
  reviewCount   Int       @default(0)

  // One progress row per (user, subject, topic).
  @@unique([userId, subject, topic])
  @@index([userId])
  @@index([userId, nextReviewAt])
}
