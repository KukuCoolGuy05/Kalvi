# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Database (Postgres / Supabase) ---
# From Supabase: Connect -> ORM tab. Pooled (6543) for the app, direct (5432) for migrations.
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Redis (Upstash) ---
# REST URL + token from the Upstash console.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
